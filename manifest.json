{
  "manifest_version": 3,
  "name": "Pi Plugin Deck",
  "version": "0.2.4",
  "description": "ChatGPT @plugin gyorsválasztó Firefox-oldalsávban: kategóriák, keresés, Created by you lista, JSON import/export és helyreállítás.",
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "Pi Plugin Deck megnyitása"
  },
  "sidebar_action": {
    "default_title": "Pi Plugin Deck",
    "default_panel": "sidebar.html",
    "open_at_install": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pi-plugin-deck@local.invalid",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
